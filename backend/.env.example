# Offline scripts and local Wrangler read this file. Never commit .env.
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6aab47850012ef4d5dd2
APPWRITE_DATABASE_ID=6aab47cd0031ba1570e2
APPWRITE_PROFILES_TABLE_ID=profiles
# Read only during the one-time event migration, not by the Worker.
APPWRITE_EVENTS_TABLE_ID=events
APPWRITE_AVATARS_BUCKET_ID=6aab6ee9001c14e2e84c
APPWRITE_RESUMES_BUCKET_ID=6aab82cb000f96070a8e
# Server-side key for profile rows and storage. No auth/session creation scopes needed.
APPWRITE_API_KEY=
# For deployment: uv run pywrangler secret put APPWRITE_API_KEY
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000
